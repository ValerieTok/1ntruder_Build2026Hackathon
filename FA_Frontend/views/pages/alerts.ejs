<section class="scam-alerts-page">
  <div class="scam-alerts-hero">
    <p class="section-label">Scam alerts</p>
    <h1>Latest Scam Alerts</h1>
    <p>Stay informed about newly reported scams and learn how to protect yourself.</p>
  </div>

  <section class="scam-alerts-stats">
    <article class="stat-card">
      <strong><%= stats.today %></strong>
      <span>Today's Alerts</span>
    </article>
    <article class="stat-card">
      <strong><%= stats.active %></strong>
      <span>Active Scams</span>
    </article>
    <article class="stat-card">
      <strong><%= stats.highRisk %></strong>
      <span>High Risk Alerts</span>
    </article>
    <article class="stat-card">
      <strong><%= stats.weekly %></strong>
      <span>Reported This Week</span>
    </article>
  </section>

  <section class="scam-alerts-controls">
    <form id="alertsFilterForm">
      <div class="alerts-search-row">
        <div class="alerts-search-input">
          <label for="searchInput" style="display: none;">Search</label>
          <input id="searchInput" type="search" placeholder="Search scams..." autocomplete="off">
        </div>
        <div class="alerts-filters">
          <select id="categorySelect" aria-label="Filter by scam category">
            <option value="">All Categories</option>
            <% categories.forEach((category) => { %>
              <option value="<%= category %>"><%= category %></option>
            <% }) %>
          </select>
          <select id="sortSelect" aria-label="Sort alerts">
            <option value="recent">Most Recent</option>
            <option value="risk">Highest Risk</option>
          </select>
        </div>
      </div>
    </form>
  </section>

  <section class="alert-grid" id="alertsGrid">
    <% alerts.forEach((alert) => { %>
      <article class="alert-card-modern" data-category="<%= alert.category %>" data-risk="<%= alert.risk %>" data-title="<%= alert.title %>" data-description="<%= alert.description %>" data-id="<%= alert.id %>">
        <div class="alert-card-image">
          <img src="<%= alert.image %>" alt="<%= alert.title %>" loading="lazy">
        </div>
        <div class="alert-card-content">
          <div class="alert-card-badges">
            <span class="alert-category-badge"><%= alert.category %></span>
            <span class="alert-risk-badge <%= alert.risk.toLowerCase() %>"><%= alert.risk %> Risk</span>
          </div>
          <h2 class="alert-card-title"><%= alert.title %></h2>
          <p class="alert-card-date">Reported: <%= alert.reportedDate %></p>
          <a class="alert-read-more" href="/alerts/<%= alert.slug || alert.id %>">Read More <span aria-hidden="true">→</span></a>
        </div>
      </article>
    <% }) %>
  </section>

  <div id="alertDetailModal" class="alert-detail-modal" style="display: none;">
    <div class="alert-detail-content">
      <button class="alert-detail-close" aria-label="Close detail view" type="button">&times;</button>
      <div id="alertDetailBody"></div>
    </div>
  </div>

  <script>
    window.__ALERTS_DATA__ = <%- JSON.stringify(alerts) %>;
  </script>
  <script src="/js/alerts.js"></script>
</section>
